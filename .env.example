# Copy to .env.local and fill in.
# Absolute base URL for the site. Used for share previews (Open Graph / Twitter
# cards), canonical URLs, sitemap.xml and robots.txt. Without it, builds on
# Vercel fall back to the project's production URL and local builds to
# localhost:3000 — so set it to the real domain before launch.
# NEXT_PUBLIC_SITE_URL=https://abode.ng
