# Copy to .env.local and fill in.

# Absolute base URL for the site — canonical URLs, share previews (Open Graph /
# Twitter cards), sitemap.xml and robots.txt all resolve against it.
# Defaults to the production domain, so this only needs setting when you want
# local absolute URLs while developing.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 measurement ID. Defaults to the live property, so this only needs setting
# to report into a different one. Note that analytics are gated on
# VERCEL_ENV=production — setting this alone will not make `next dev` report.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
