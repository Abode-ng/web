# Copy to .env.local and fill in.

# Absolute base URL for the site — canonical URLs, share previews (Open Graph /
# Twitter cards), sitemap.xml and robots.txt all resolve against it.
# Defaults to the production domain, so this only needs setting when you want
# local absolute URLs while developing.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 measurement ID. Required for analytics to report at all, and kept out of
# the repo because this one is public — a fork carrying the ID would report into
# our property. Set it in Vercel's project settings; setting it here only will
# not reach production. Analytics are additionally gated on VERCEL_ENV being
# `production`, so `next dev` reports nothing whatever this is set to.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
